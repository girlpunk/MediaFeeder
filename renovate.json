{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended"],
  "configMigration": true,
  "ignorePaths": ["Might be useful/**"],
  "lockFileMaintenance": {
    "enabled": true
  }
  "automerge": true,
  "automergeStrategy": "squash",
  "assignAutomerge": true,
  "reviewers": ["girlpunk"],
  "assignees": ["girlpunk"],
  "assigneesFromCodeOwners": true,
}
