@page "/Sessions"
@page "/Sessions/{PlayerId}"
@implements IDisposable
@using MediaFeeder.Components.Layout
@using MediaFeeder.PlaybackManager

@layout ListLayout

<PageTitle>MediaFeeder Sessions</PageTitle>

<Content Style="background: #fff; padding: 1em;">
    <Tabs StandaloneInCard DefaultActiveKey="@(SessionManager?.PlaybackSessions.Values.FirstOrDefault(s => s.State == PlayerState.Playing)?.PlayerId)" @bind-ActiveKey="PlayerId">
        @if (SessionManager != null)
        {
            @foreach (var session in SessionManager.PlaybackSessions.OrderBy(static s => s.Value.Title).Select(s => s.Value))
            {
                <TabPane Key="@session.Title">
                    <TabTemplate>
                        <span style="font-size: 120%;">@(session.State switch
                                                       {
                                                           PlayerState.Playing => "⏵",
                                                           PlayerState.Advert => "⏵",
                                                           PlayerState.Paused => "⏸",
                                                           PlayerState.Loading => "⧖",
                                                           PlayerState.Disconnected => "X",
                                                           _ => "⏹"
                                                       })
                        </span>
                        @(session.Title)
                    </TabTemplate>
                    <ChildContent>
                        <SessionInfo Session="@session"/>
                    </ChildContent>
                </TabPane>
            }
        }
    </Tabs>
</Content>

@code {
    [Inject] public PlaybackSessionManager? SessionManager { get; set; }

    [Parameter]
    public string? PlayerId {get;set;} = null;

    private void OnSessionUpdated()
    {
        InvokeAsync(StateHasChanged);
    }

    protected override void OnParametersSet()
    {
        if (SessionManager != null)
            SessionManager.UpdateEvent += OnSessionUpdated;
    }

    public void Dispose()
    {
        SessionManager?.UpdateEvent -= OnSessionUpdated;
    }
}
